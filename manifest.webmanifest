{
  "id": "./",
  "name": "Orçamento de Bebidas",
  "short_name": "Orçamento",
  "description": "Gestão de orçamento, lançamentos, relatórios, malote de notas e nota de recusa e devolução.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./?origem=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f4f7fb",
  "theme_color": "#102b46",
  "categories": [
    "finance",
    "business",
    "productivity"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
